# Copy this into Streamlit Community Cloud → your app → Settings → Secrets
# (or, for LOCAL dev, save a real copy as .streamlit/secrets.toml — which is gitignored).
# These become environment variables the generators read (lib/db.py, google_auth.py).

# ── Odoo POS Postgres (read-only) ──
DB_HOST = "64.227.172.210"
DB_PORT = "5432"
DB_NAME = "Litmus"
DB_USER = "reporting_reader"
DB_PASSWORD = "PUT-THE-REAL-PASSWORD-HERE"

# ── Supabase (marketing warehouse) — session pooler ──
SUPABASE_DB_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Google service account key (the WHOLE service_account.json, as one string) ──
# IMPORTANT: use LITERAL triple-quotes ''' (not """). The private_key contains \n
# escapes and """ would corrupt them, breaking the JSON. ''' keeps them intact.
SERVICE_ACCOUNT_JSON = '''
{ "type": "service_account", "project_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "...@...", "...": "..." }
'''
