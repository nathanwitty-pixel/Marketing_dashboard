# Copy this into Streamlit Community Cloud → your app → Settings → Secrets
# (or, for LOCAL dev, save a real copy as .streamlit/secrets.toml — which is gitignored).
# These become environment variables the generators read (lib/db.py, google_auth.py).

# ── Odoo POS Postgres (read-only) ──
DB_HOST = "64.227.172.210"
DB_PORT = "5432"
DB_NAME = "Litmus"
DB_USER = "reporting_reader"
DB_PASSWORD = "PUT-THE-REAL-PASSWORD-HERE"

# ── Supabase (marketing warehouse) — session pooler ──
SUPABASE_DB_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Google service account key — TWO ways, pick ONE ──
#
# OPTION A (recommended, most robust): a TOML table. Paste each field; the private_key
# stays a normal "..." string with \n escapes. The app rebuilds valid JSON from this.
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
#
# OPTION B: the whole service_account.json as one string. If you use this, you MUST use
# LITERAL triple-quotes ''' (not """) — """ mangles the private key's \n and breaks it.
# SERVICE_ACCOUNT_JSON = '''
# { ...entire service_account.json... }
# '''
