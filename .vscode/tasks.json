{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Current Performance",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/generators/current_performance.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Run Forward Projections",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/generators/forward_projections.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": false }
    },
    {
      "label": "Run New Products",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/generators/new_products.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": false }
    },
    {
      "label": "Run Posting Analysis",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/generators/posting_yields.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": false }
    },
    {
      "label": "Run All Dashboard Scripts",
      "dependsOrder": "sequence",
      "dependsOn": ["Run Current Performance", "Run Forward Projections", "Run New Products", "Run Offer Type Analysis", "Run Posting Analysis"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
